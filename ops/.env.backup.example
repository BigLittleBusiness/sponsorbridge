# Copy this file to ops/.env.backup and chmod it to 600.
# This file is read only by the host backup script and is not mounted into app containers.

BACKUP_DIR=/opt/sponsorbridge/backups/mysql
BACKUP_RETENTION_DAYS=14

# Optional encrypted/offsite copy. Install and configure the AWS CLI on the host
# with a storage-only credential, then set a bucket URI such as:
# BACKUP_S3_URI=s3://sponsorbridge-offsite-backups/mysql
BACKUP_S3_URI=
