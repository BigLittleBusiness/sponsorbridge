# Copy this file to ops/.env.production on the BinaryLane VPS.
# Do not commit the real file. Use unique, long secrets for every password and key.

# Domains and app runtime
APP_DOMAIN=app.sponsorbridge.com
APP_BASE_URL=https://app.sponsorbridge.com
ACME_EMAIL=yourname@biglittlebusiness.com
NODE_ENV=production
JWT_SECRET=replace_with_a_random_64_character_secret
SCHEDULER_SECRET=replace_with_a_different_random_64_character_secret

# Private MySQL service. If your password contains reserved URL characters,
# URL-encode it in DATABASE_URL (for example, @ becomes %40).
MYSQL_ROOT_PASSWORD=replace_with_a_separate_random_root_password
MYSQL_DATABASE=sponsorbridge
MYSQL_USER=sponsorbridge
MYSQL_PASSWORD=replace_with_a_random_database_password
DATABASE_URL=mysql://sponsorbridge:replace_with_url_encoded_database_password@db:3306/sponsorbridge

# Stripe live mode. Keep both values secret; configure the endpoint in Stripe
# only after APP_DOMAIN is serving HTTPS.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_CHILD_WEBHOOK_SECRET=whsec_replace_me_for_api_stripe_webhook
STRIPE_PROJECT_WEBHOOK_SECRET=whsec_replace_me_for_api_projects_webhook
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# New uploads use portable S3-compatible object storage. Cloudflare R2, Amazon
# S3, DigitalOcean Spaces, or another compatible provider may be used.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://replace-with-your-s3-compatible-endpoint
S3_REGION=auto
S3_BUCKET=sponsorbridge-production-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

# Temporary only: allows existing /manus-storage/* records to redirect to the
# currently published Manus site while legacy media is migrated to object storage.
LEGACY_MANUS_STORAGE_ORIGIN=https://sponsorapp-k6ifqkyq.manus.space

# Do not set BUILT_IN_FORGE_API_URL or BUILT_IN_FORGE_API_KEY on BinaryLane.
# Do not set PORT; Compose supplies the application port.
